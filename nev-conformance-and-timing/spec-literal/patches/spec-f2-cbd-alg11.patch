+/* ---------------------------------------------------------------------------
+ * SPEC-LITERAL Algorithm 11, CBD_eta(B).   (NEV spec text, p.25)
+ *
+ *   Input : byte array B in B^{ceil(n*eta/4)}
+ *   1  b := BytesToBits(B)                       (Algorithm 4: b[8i+j] = bit j of B[i],
+ *                                                 j = 0 is the LEAST significant bit)
+ *   2  for i := 0; i < n; i++
+ *   3      x := sum_{j=0}^{eta-1} b[2*i*eta + j]
+ *   4      y := sum_{j=0}^{eta-1} b[2*i*eta + eta + j]
+ *   5      f[i] := (x - y) mod q
+ *
+ * i.e. coefficient i consumes the 2*eta CONTIGUOUS bits b[2*i*eta .. 2*i*eta+2*eta-1].
+ * This function is a direct transcription; it is never conditional, so that the
+ * self-check binary can compare it against the submitted cbd1/cbd2/cbd4.
+ * ------------------------------------------------------------------------- */
+void cbd_eta_alg11(int16_t *f, const uint8_t *B, int eta, int n)
+{
+	for (int i = 0; i < n; i++) {
+		int x = 0, y = 0;
+		for (int j = 0; j < eta; j++) {
+			unsigned long bx = (unsigned long)(2 * i * eta) + (unsigned long)j;
+			unsigned long by = bx + (unsigned long)eta;
+			x += (B[bx >> 3] >> (bx & 7u)) & 1u;
+			y += (B[by >> 3] >> (by & 7u)) & 1u;
+		}
+		f[i] = (int16_t)(x - y);
+	}
+}
