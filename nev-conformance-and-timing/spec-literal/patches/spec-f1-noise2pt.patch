+++ b/pack.c	(SPEC_F1: spec 3.1 Noise2Pt centre (q+1)/2, threshold k(q-1)/4)
@@ -359,11 +359,29 @@
 	int16_t r, m;
 	r = caddq(x);
 
+#ifdef SPEC_F1
+	/* spec section 3.1, Noise2Pt: w~_i = w_i - (q+1)/2  mod+- q.
+	   r = caddq(x) is in [0, q-1], so r - (q+1)/2 is in [-(q+1)/2, (q-3)/2];
+	   only the value r = 0 falls outside the centred range (-q/2, q/2] and has
+	   to be lifted by +q (giving (q-1)/2, which is what the submitted
+	   r - (q-1)/2 also yields -- the one input where the two agree). */
+	r = r - (PARAM_Q + 1) / 2;
+	if (r < -(int16_t)((PARAM_Q - 1) / 2))
+		r = r + PARAM_Q;
+#else
 	r = r - PARAM_Q / 2;
+#endif
 	m = r >> 15;
 	return (r + m) ^ m;
 }
 
+/* spec section 3.1, Noise2Pt threshold: M_j = 1 iff t_j < k*(q-1)/4, k = 4. */
+#ifdef SPEC_F1
